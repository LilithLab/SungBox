{
  "log": { "level": "info", "timestamp": true },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-cn",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "tls": { "enabled": true, "server_name": "dns.alidns.com" },
        "detour": "direct"
      },
      { "type": "udp", "tag": "dns-proxy", "server": "1.1.1.1", "detour": "proxy" }
    ],
    "rules": [
      { "rule_set": ["geosite-cn"], "server": "dns-cn" },
      { "domain_suffix": [".cn"], "server": "dns-cn" }
    ],
    "final": "dns-proxy"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "YOUR_SERVER_ADDRESS",
      "server_port": 443,
      "uuid": "YOUR-UUID",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "server_name": "www.example.com",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "YOUR_REALITY_PUBLIC_KEY",
          "short_id": "YOUR_SHORT_ID"
        }
      },
      "domain_resolver": "dns-proxy",
      "network_type": ["cellular"]
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": "dns-cn",
      "network_type": ["wifi"]
    }
  ],
  "route": {
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct" },
      { "rule_set": ["geosite-cn"], "outbound": "direct" },
      { "rule_set": ["geoip-cn"], "outbound": "direct" }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "http_client": { "detour": "proxy" },
        "update_interval": "7d"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "http_client": { "detour": "proxy" },
        "update_interval": "7d"
      }
    ],
    "final": "proxy",
    "default_domain_resolver": "dns-cn",
    "auto_detect_interface": true
  },
  "experimental": { "cache_file": { "enabled": true } }
}
